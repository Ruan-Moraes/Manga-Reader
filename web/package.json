{
  "name": "toonlira-frontend-workspace",
  "private": true,
  "scripts": {
    "dev:app": "pnpm --filter toonlira dev",
    "dev:landing": "pnpm --filter landing-page dev",
    "build": "pnpm --filter './packages/**' build && pnpm -r --filter !./packages/** build",
    "build:app": "pnpm --filter toonlira build",
    "build:landing": "pnpm --filter landing-page build",
    "test": "pnpm -r test",
    "test:app": "pnpm --filter toonlira test",
    "brand:generate": "node ../scripts/brand.mjs generate",
    "brand:check": "node ../scripts/brand.mjs generate --check",
    "rebrand:check": "node ../scripts/brand.mjs rebrand --check",
    "rebrand:apply": "node ../scripts/brand.mjs rebrand --apply",
    "test:landing": "pnpm --filter landing-page test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "i18n:clean": "pnpm run i18n:clean:app && pnpm run i18n:clean:landing",
    "i18n:clean:app": "node scripts/i18n-cleaner.ts --src toonlira/src --i18n toonlira/src/i18n/locales --dry-run",
    "i18n:clean:landing": "node scripts/i18n-cleaner.ts --src landing-page/src --i18n landing-page/src/i18n/locales --dry-run",
    "i18n:clean:app:write": "node scripts/i18n-cleaner.ts --src toonlira/src --i18n toonlira/src/i18n/locales --backup",
    "i18n:clean:landing:write": "node scripts/i18n-cleaner.ts --src landing-page/src --i18n landing-page/src/i18n/locales --backup"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
