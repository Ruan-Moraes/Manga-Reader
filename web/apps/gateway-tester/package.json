{
  "name": "gateway-tester",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend para testar e debugar o Translation Gateway",
  "scripts": {
    "dev": "vite --host --force",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run --pool=forks",
    "test:watch": "vitest --pool=forks"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.52.0",
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.73.3",
    "axios": "^1.7.7",
    "classnames": "^2.3.2",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@tailwindcss/vite": "^4.1.3",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^2.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.1",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
