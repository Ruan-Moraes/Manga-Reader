{
  "version": 1,
  "description": "Corpus de validacao do translation-gateway: capitulos livres de direitos (CC BY, CC BY-NC-SA e dominio publico) cobrindo cenarios de texto. Imagens nao versionadas: rode node scripts/fetch-corpus.mjs dentro de web/apps/gateway-tester.",
  "scenarioCatalog": {
    "balloon": "fala dentro de balao",
    "shout-balloon": "balao de grito (contorno serrilhado, letras grandes)",
    "caption-box": "legenda/narracao em caixa retangular",
    "sfx-in-art": "onomatopeia desenhada sobre a arte",
    "text-in-art": "texto diegetico na arte (placas, telas, livros, rotulos)",
    "text-over-border": "texto cruzando a borda do balao ou do quadro (acima do balao)",
    "title-lettering": "titulo/logotipo estilizado",
    "splash-title": "pagina de abertura com titulo grande desenhado",
    "vertical-text": "texto CJK vertical, leitura da direita para a esquerda",
    "outside-panel-note": "nota/rodape fora do quadro",
    "dense-text": "muito texto em pouco espaco",
    "small-text": "letra pequena em relacao a pagina",
    "hand-lettered-caps": "letreiramento manual em caixa alta",
    "colored-background": "texto sobre arte colorida ou gradiente",
    "symbols-in-text": "simbolos misturados ao texto (notas musicais, reticencias)",
    "monochrome": "pagina em preto e branco com retícula",
    "no-text": "pagina sem texto: o resultado deve ser identico ao original"
  },
