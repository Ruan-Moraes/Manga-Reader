export GATEWAY_ENABLED=true
export GATEWAY_KEY=local-dev
export GATEWAY_DISPATCH_MODE=local-ack
export GATEWAY_STORAGE_MODE=gcs
export GATEWAY_STORAGE_BUCKET=<seu-bucket-temporario>
export GATEWAY_GCP_PROJECT_ID=<seu-projeto-gcp>
export GATEWAY_OCR_MODE=vision
# Falas duvidosas relidas por página numa chamada extra (mosaico); 0 desliga.
export GATEWAY_OCR_REREAD_MAX_REGIONS=8
export GATEWAY_TRANSLATION_MODE=google
export GATEWAY_TRANSLATION_PROJECT_ID=<seu-projeto-gcp>
export GATEWAY_TRANSLATION_ENABLED_PAIRS=en:pt-BR,ja:pt-BR
export GATEWAY_RESULT_DOWNLOAD_MODE=gcs
export GATEWAY_RESULT_DOWNLOAD_PROJECT_ID=<seu-projeto-gcp>
export GATEWAY_RESULT_DOWNLOAD_SIGNER_SERVICE_ACCOUNT=<signer-sa>@<projeto>.iam.gserviceaccount.com
export GATEWAY_RENDERING_MODE=local
export GATEWAY_RENDERING_TEMP_DIR=$HOME/.cache/toonlira-render
export GATEWAY_RENDERING_ENCODER_PATH=$HOME/.local/share/toonlira-webp/bin/cwebp
export GATEWAY_RENDERING_ENCODER_SHA256=<sha256 do binário>
export GATEWAY_RENDERING_DECODER_PATH=$HOME/.local/share/toonlira-webp/bin/dwebp
export GATEWAY_RENDERING_DECODER_SHA256=<sha256 do binário>
export SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/manga_translation_gateway
export SPRING_DATASOURCE_USERNAME=manga
export SPRING_DATASOURCE_PASSWORD=manga_secret
