[ {
  "text" : "STOP-STOP! I\nTIGER GIRL\nCOMMAND IT!\n",
  "box" : [ 0.0365, 0.022, 0.1854, 0.0518 ]
}, {
  "text" : "BUT THE BATTLE IS ALREADY JOINED.\nAND THE GOLD-STARRED ONES PROVE\nMORE THAN EQUAL.\n",
  "box" : [ 0.3198, 0.022, 0.7427, 0.0546 ]
}, {
  "text" : "FOR\nMORGO!\n",
  "box" : [ 0.4688, 0.0652, 0.5542, 0.0837 ]
}, {
  "text" : "AND\nTHEN...\n",
  "box" : [ 0.0365, 0.3433, 0.1177, 0.3645 ]
}, {
  "text" : "BACK-BACK! AWAY\nWARUMBI FOOLS!\n",
  "box" : [ 0.0325, 0.3898, 0.2506, 0.4165 ]
}, {
  "text" : "BOTH TIGER GIRL AND\nMORGO'S MEN BEING TOO\nMUCH FOR THEM, THE\nWARUMBI GO.\n",
  "box" : [ 0.3031, 0.3447, 0.5594, 0.3865 ]
}, {
  "text" : "AND YOU, ABDOLA..\nWITH BENZALI.\nFOLLOW AND SEE\nTHAT THEY RETURN!\nI SHALL SPEAK\nWITH MORGO!\n",
  "box" : [ 0.3094, 0.3943, 0.5229, 0.4553 ]
}, {
  "text" : "IS THIS\nWISE\nTIGER\nGIRL?\n",
  "box" : [ 0.3917, 0.4872, 0.4698, 0.5277 ]
}, {
  "text" : "FOR\nN'DASU!\nAAAH..\n",
  "box" : [ 0.7146, 0.0745, 0.8021, 0.1043 ]
}, {
  "text" : "DO AS I SAY!\nSTAND ASIDE,\nSTARRED ONES!\n",
  "box" : [ 0.701, 0.266, 0.876, 0.2972 ]
}, {
  "text" : "THE WAY IS\nDIFFICULT!\n",
  "box" : [ 0.081, 0.6614, 0.2264, 0.6888 ]
}, {
  "text" : "IN MORGO'S GROTTO.\n",
  "box" : [ 0.3281, 0.661, 0.5688, 0.6738 ]
}, {
  "text" : "WHAT DO YOU WANT?",
  "box" : [ 0.6059, 0.6071, 0.736, 0.6369 ]
}, {
  "text" : "HH\n",
  "box" : [ 0.1427, 0.7255, 0.1958, 0.7532 ]
}, {
  "text" : "I AM TIGER GIRL.. WHAT ARE YOU DOING? WHY DO THESE ONES BREATHE SMOKE?",
