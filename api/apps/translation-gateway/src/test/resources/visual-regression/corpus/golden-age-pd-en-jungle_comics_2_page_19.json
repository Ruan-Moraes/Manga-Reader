    "polygon" : [ [ 0.07604166666666666, 0.08295964125560538 ], [ 0.47291666666666665, 0.08295964125560538 ], [ 0.47291666666666665, 0.11883408071748879 ], [ 0.07604166666666666, 0.11883408071748879 ] ]
