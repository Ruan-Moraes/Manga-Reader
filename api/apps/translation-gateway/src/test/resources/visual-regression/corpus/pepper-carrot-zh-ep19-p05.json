  "regions" : [ {
    "source" : "我们每个人\n都有过失败,\n",
    "translation" : "Todos nós já tivemos fracassos,",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.11888996124267578, 0.027062818228480327 ], [ 0.23143145243326824, 0.027062818228480327 ], [ 0.23143145243326824, 0.062022225253553276 ], [ 0.11888996124267578, 0.062022225253553276 ] ]
  }, {
    "source" : "我已经不再是会写这种诗的卡宴椒了。",
