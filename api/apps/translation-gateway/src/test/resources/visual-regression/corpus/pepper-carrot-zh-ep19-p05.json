    "polygon" : [ [ 0.40916043599446617, 0.2582278515919145 ], [ 0.5437090047200521, 0.2582278515919145 ], [ 0.5437090047200521, 0.2933499439653144 ], [ 0.40916043599446617, 0.2933499439653144 ] ]
  }, {
    "source" : "混沌阿",
    "translation" : "Caos",
    "kind" : "unknown",
