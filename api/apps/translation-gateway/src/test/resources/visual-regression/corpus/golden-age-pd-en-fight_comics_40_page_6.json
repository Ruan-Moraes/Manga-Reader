  "regions" : [ {
    "source" : "STOP-STOP! I\nTIGER GIRL\nCOMMAND IT!\n",
    "translation" : "PAREM, PAREM! EU, TIGER GIRL, ORDENO!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.036458333333333336, 0.02198581560283688 ], [ 0.18541666666666667, 0.02269503546099291 ], [ 0.18541666666666667, 0.05177304964539007 ], [ 0.036458333333333336, 0.05106382978723404 ] ]
  }, {
    "source" : "BUT THE BATTLE IS ALREADY JOINED.\nAND THE GOLD-STARRED ONES PROVE\nMORE THAN EQUAL.\n",
    "translation" : " Mas a batalha já começou. E aqueles das estrelas douradas mostram-se mais do que à altura.",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.31979166666666664, 0.02198581560283688 ], [ 0.7427083333333333, 0.023404255319148935 ], [ 0.7427083333333333, 0.05460992907801419 ], [ 0.31979166666666664, 0.05319148936170213 ] ]
  }, {
    "source" : "FOR\nMORGO!\n",
    "translation" : " POR MORGO!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.46875, 0.06524822695035461 ], [ 0.5541666666666667, 0.06595744680851064 ], [ 0.5541666666666667, 0.08368794326241134 ], [ 0.46875, 0.08297872340425531 ] ]
  }, {
    "source" : "AND\nTHEN...\n",
    "translation" : " E então...",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.0375, 0.3432624113475177 ], [ 0.11770833333333333, 0.3453900709219858 ], [ 0.11666666666666667, 0.3645390070921986 ], [ 0.036458333333333336, 0.3624113475177305 ] ]
  }, {
    "source" : "BACK-BACK! AWAY\nWARUMBI FOOLS!\n",
    "translation" : " Atrás, atrás! Afastem-se, tolos Warumbi!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.036458333333333336, 0.3943262411347518 ], [ 0.24479166666666666, 0.3943262411347518 ], [ 0.24479166666666666, 0.4134751773049645 ], [ 0.036458333333333336, 0.4134751773049645 ] ]
  }, {
    "source" : "BOTH TIGER GIRL AND\nMORGO'S MEN BEING TOO\nMUCH FOR THEM, THE\nWARUMBI GO.\n",
    "translation" : " Como tanto Tiger Girl quanto os homens de Morgo eram adversários poderosos demais para eles, os Warumbi vão embora.",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.303125, 0.3446808510638298 ], [ 0.559375, 0.34609929078014184 ], [ 0.559375, 0.38652482269503546 ], [ 0.303125, 0.3851063829787234 ] ]
  }, {
    "source" : "AND YOU, ABDOLA.\nWITH BENZALI. .\nFOLLOW AND SEE\nTHAT THEY RETURN!\nI SHALL SPEAK\nWITH MORGO!",
    "translation" : " E você, Abdola. Com Benzali... vá atrás e certifique-se de que eles retornem! Eu falarei com Morgo!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.3104166666666667, 0.3943262411347518 ], [ 0.5229166666666667, 0.39574468085106385 ], [ 0.521875, 0.4553191489361702 ], [ 0.309375, 0.45390070921985815 ] ]
  }, {
    "source" : "IS THIS\nWISE\nTIGER\nGIRL?\n",
    "translation" : " Esta é a sábia garota-tigre?",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.39166666666666666, 0.48723404255319147 ], [ 0.46979166666666666, 0.4879432624113475 ], [ 0.46979166666666666, 0.5276595744680851 ], [ 0.39166666666666666, 0.5269503546099291 ] ]
  }, {
    "source" : "FOR\nN'DASU!\nAAAH.",
    "translation" : " POR N'DASU! AAAH.",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.7145833333333333, 0.07588652482269503 ], [ 0.8010416666666667, 0.07446808510638298 ], [ 0.8020833333333334, 0.10283687943262411 ], [ 0.715625, 0.10425531914893617 ] ]
  }, {
    "source" : "DO AS I SAY!\nSTAND ASIDE,\nSTARRED ONES!\n",
