  "regions" : [ {
    "source" : "AS THE HERD\nCHARGES-\n",
    "translation" : "Enquanto a manada avança em disparada...",
    "kind" : "text_free",
    "polygon" : [ [ 0.06458333333333334, 0.06680299931833675 ], [ 0.15416666666666667, 0.06612133605998637 ], [ 0.15416666666666667, 0.08588957055214724 ], [ 0.06458333333333334, 0.08657123381049761 ] ]
  }, {
    "source" : "IT'S\nTHAT DOG\nHE'S STARTED\nA STAMPEDE-\n",
    "translation" : " É aquele cachorro! Ele provocou uma debandada...",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.215625, 0.06680299931833675 ], [ 0.32916666666666666, 0.06680299931833675 ], [ 0.32916666666666666, 0.10702113156100886 ], [ 0.215625, 0.10702113156100886 ] ]
  }, {
    "source" : "JUNGLE COMICS\n",
    "translation" : " JUNGLE COMICS",
    "kind" : "text_free",
    "polygon" : [ [ 0.40208333333333335, 0.032719836400818 ], [ 0.5760416666666667, 0.03067484662576687 ], [ 0.5760416666666667, 0.04294478527607362 ], [ 0.40208333333333335, 0.044989775051124746 ] ]
  }, {
    "source" : "I'VE GOT TO GET OUT THEY'LL KILL ME-BUT HOW? THEY'RE POURING THROUGH THE PASS AND THERE'S NO OTHER WAY OUT-",
    "translation" : " Preciso sair daqui, eles vão me matar — mas como? Eles estão passando em massa pela garganta e não há outra saída —",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.36354166666666665, 0.06475800954328562 ], [ 0.571875, 0.06475800954328562 ], [ 0.571875, 0.12610770279481937 ], [ 0.36354166666666665, 0.12610770279481937 ] ]
  }, {
    "source" : "BUT AS THE INFURIATED\nELEPHANTS DESTROY ALL IN\nTHEIR PATH, CAMILLA AND HER\nFRIENDS ESCAPE INTO THE\nPOOL\n",
    "translation" : " Mas, enquanto os elefantes enfurecidos destroem tudo em seu caminho, Camilla e seus amigos escapam para a piscina.",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.6416666666666667, 0.06339468302658487 ], [ 0.9083333333333333, 0.06339468302658487 ], [ 0.9083333333333333, 0.11315610088616224 ], [ 0.6416666666666667, 0.11315610088616224 ] ]
  }, {
    "source" : "LEAVING THE DESECRATORS\nTO CERTAIN DEATH-\n",
    "translation" : " Deixando os profanadores à morte certa —",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.06875, 0.35719154737559644 ], [ 0.3125, 0.35719154737559644 ], [ 0.3125, 0.3769597818677573 ], [ 0.06875, 0.3769597818677573 ] ]
  }, {
    "source" : "AS AT THE RIVER NEARBY-\n",
    "translation" : " Como no rio próximo —",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.328125, 0.612815269256987 ], [ 0.5572916666666666, 0.6141785957736878 ], [ 0.5572916666666666, 0.6250852079072938 ], [ 0.328125, 0.623721881390593 ] ]
  }, {
    "source" : "I DIDN'T THINK WE'D MAKE\nIT THROUGH THE GROTTO-\nBUT WE DID AND THAT'S\nTHE END OF YOUR PARTNER\nAND HIS HENCHMEN\n",
    "translation" : " Eu não achava que conseguiríamos atravessar a gruta — mas conseguimos, e esse é o fim do seu parceiro e dos capangas dele.",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.3375, 0.6366734832992502 ], [ 0.5802083333333333, 0.6366734832992502 ], [ 0.5802083333333333, 0.6871165644171779 ], [ 0.3375, 0.6871165644171779 ] ]
  }, {
    "source" : "I DON'T KNOW HOW I CAN REPAY YOU.",
    "translation" : " Não sei como posso retribuir a você.",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.459375, 0.700068166325835 ], [ 0.5854166666666667, 0.700068166325835 ], [ 0.5854166666666667, 0.7273346966598501 ], [ 0.459375, 0.7273346966598501 ] ]
  }, {
    "source" : "REMEMBER ONE THING, TRADER.\nTHE LAW OF THE JUNGLE IS\nDEATH TO TRANSGRESSORS.\nNEVER PLOT TO ROB THE\nJUNGLE OF ITS OWN.",
    "translation" : " Lembre-se de uma coisa, mercador: a lei da selva é a morte para os transgressores. Nunca planeje roubar da selva o que lhe pertence.",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.6447916666666667, 0.6155419222903885 ], [ 0.9114583333333334, 0.6155419222903885 ], [ 0.9114583333333334, 0.665303340149966 ], [ 0.6447916666666667, 0.665303340149966 ] ]
  }, {
    "source" : "YOU'RE RIGHT\nCAMILLA NO\nMORE GRAVE\nROBBING FOR ME\n",
    "translation" : " Você tem razão, Camilla: chega de roubar túmulos para mim.",
    "kind" : "text_bubble",
