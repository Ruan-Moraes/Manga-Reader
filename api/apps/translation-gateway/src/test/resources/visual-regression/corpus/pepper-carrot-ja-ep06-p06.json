  }, {
    "source" : "ごめんなさい!\n",
    "translation" : "Desculpe!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.42409968058268227, 0.29620534138507154 ], [ 0.5544980875651042, 0.29620534138507154 ], [ 0.5544980875651042, 0.31862204678087347 ], [ 0.42409968058268227, 0.31862204678087347 ] ]
  }, {
    "source" : "およこしなさい!",
    "translation" : "Passe isso para cá!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.10311765670776367, 0.39604084060852784 ], [ 0.18932769775390626, 0.39604084060852784 ], [ 0.18932769775390626, 0.4333850906555911 ], [ 0.10311765670776367, 0.4333850906555911 ] ]
  }, {
    "source" : "内気なふりはおやめなさい、あなたはコンテストを台無しにしているわ",
