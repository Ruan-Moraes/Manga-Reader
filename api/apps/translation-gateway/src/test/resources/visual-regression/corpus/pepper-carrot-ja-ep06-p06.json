  "regions" : [ {
    "source" : "先ほどの実演の後ではシチミが勝つのは難しそうになってきました!",
    "translation" : "Depois daquela demonstração, parece que vai ser difícil para a Shichimi vencer!",
    "kind" : "text_bubble",
