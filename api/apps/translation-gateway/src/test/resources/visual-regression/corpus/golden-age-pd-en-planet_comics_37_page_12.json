  }, {
    "source" : "HMM WHAT'S ALL THE\nCOMMOTION ON THE\nPLANET ARES?\n",
    "translation" : "Hmm, o que é toda essa agitação no planeta Ares?",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.3460895856221517, 0.6790939962302737 ], [ 0.5839693705240886, 0.6790939962302737 ], [ 0.5839693705240886, 0.7172212042924171 ], [ 0.3460895856221517, 0.7172212042924171 ] ]
