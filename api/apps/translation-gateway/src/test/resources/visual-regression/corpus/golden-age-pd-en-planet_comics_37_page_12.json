    "polygon" : [ [ 0.8916666666666667, 0.6283880171184023 ], [ 0.9739583333333334, 0.6298145506419401 ], [ 0.9729166666666667, 0.6676176890156919 ], [ 0.890625, 0.666191155492154 ] ]
  }, {
    "source" : "THAT DOES IT! MY\nENLARGER LENS SHOWS\n-NO IT CAN'T BE!\nBUT IT IS!\n",
    "translation" : "É isso! A lente do meu ampliador mostra... não, não pode ser! Mas é!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.7081165949503581, 0.6772103520500847 ], [ 0.9601367314656576, 0.6772103520500847 ], [ 0.9601367314656576, 0.7285475792116173 ], [ 0.7081165949503581, 0.7285475792116173 ] ]
  }, {
    "source" : "ONLY THE MADNESS OF A WARPED\nGENIUS COULD CONCEIVE SUCH A\nPLAN DIABOLICALLY CLEVER, IT\nWOULD DESTROY THE UNIVERSE!\nBUT THERE WAS MYSTA, WHOSE\nMIND WAS SCHOOLED TO PEACE\nAND CULTURE AND FREEDOM-\nWHOSE MIND WAS FILLED WITH ALL\nKNOWLEDGE, COULD SHE STOP\nTHE COMING DEBACLE?\n",
    "translation" : "Somente a loucura de um gênio distorcido poderia conceber tal plano! Diabolicamente engenhoso, destruiria o universo! Mas havia Mysta, cuja mente fora educada para a paz, a cultura e a liberdade — cuja mente estava repleta de todo o conhecimento. Poderia ela impedir a catástrofe iminente?",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.13020833333333334, 0.8559201141226819 ], [ 0.44583333333333336, 0.854493580599144 ], [ 0.446875, 0.9657631954350927 ], [ 0.13125, 0.9671897289586305 ] ]
