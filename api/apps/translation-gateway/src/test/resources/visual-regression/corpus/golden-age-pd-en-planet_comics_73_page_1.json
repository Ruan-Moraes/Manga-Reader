  }, {
    "source" : "BRAD CUMMINGS NATCHES AS HIS BOSS, THE GREAT\nPHYSICIST, WALTER JACKSON, MAKES AN ADJUSTMENT ON\nTHE NEAR-COMPLETE NEW ELECTRONIC CALCULATOR...\n",
    "translation" : "Brad Cummings observa enquanto seu chefe, o grande físico Walter Jackson, faz um ajuste na quase concluída nova calculadora eletrônica...",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.5114805857340495, 0.24100538040701636 ], [ 0.9000539779663086, 0.24100538040701636 ], [ 0.9000539779663086, 0.27694350822095326 ], [ 0.5114805857340495, 0.27694350822095326 ] ]
  }, {
    "source" : "EXCUSE ME, PROFESSOR\nJACKSON, BUT THAT\nADJUSTMENT IS\nNOT ACCORDING TO\nTHE BLUEPRINT...\n",
    "translation" : "Com licença, Professor Jackson, mas esse ajuste não está de acordo com a planta...",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.5111872990926106, 0.2848246104061116 ], [ 0.6596393585205078, 0.2848246104061116 ], [ 0.6596393585205078, 0.33286572282255833 ], [ 0.5111872990926106, 0.33286572282255833 ] ]
  }, {
    "source" : "CUMMINGS, CEREBEX 15 GOING TO BE\nUNIQUE-THE MOST POWERFUL\nELECTRONIC BRAIN IN THE WORLD!\nYOU CAN'T BUILD GENIUS FROMA\nBLUEPRINT!\n",
    "translation" : "Cummings, o Cerebex vai ser único — o cérebro eletrônico mais poderoso do mundo! Você não pode construir um gênio a partir de uma planta!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.6854166666666667, 0.2854223433242507 ], [ 0.9166666666666666, 0.2847411444141689 ], [ 0.9166666666666666, 0.3303814713896458 ], [ 0.6854166666666667, 0.3310626702997275 ] ]
  }, {
    "source" : "HAVE ANOTHER\nARGUMENT\nWITH OLD\nJACKSON,\nBRAD?\n",
    "translation" : "Teve outra discussão com o velho Jackson, Brad?",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.5177083333333333, 0.5054495912806539 ], [ 0.6166666666666667, 0.5061307901907357 ], [ 0.6166666666666667, 0.5565395095367848 ], [ 0.5177083333333333, 0.555858310626703 ] ]
  }, {
    "source" : "YOU KNOW, DON, I'M WORRIED. JACKSON IS DOING THINGS TO THAT BRAIN I DON'T UNDERSTAND AT ALL.",
    "translation" : "Sabe, Don, estou preocupado. O Jackson está fazendo coisas naquele cérebro que eu não entendo de jeito nenhum.",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.6302287419637044, 0.5041660651848816 ], [ 0.8316365559895833, 0.5041660651848816 ], [ 0.8316365559895833, 0.5488267529562968 ], [ 0.6302287419637044, 0.5488267529562968 ] ]
  }, {
    "source" : "THE GIANT ELECTRONIC \"BRAIN\" WAS A MARVEL OF MODERN INGENUITY--UNTIL IT WAS TWISTED INTO THE DEVILISH\nPATTERNS OF A MADMAN'S MIND!\n",
    "translation" : "O gigantesco \"cérebro\" eletrônico era uma maravilha da engenhosidade moderna — até ser distorcido nos padrões diabólicos da mente de um louco!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.03021061420440674, 0.893288261559094 ], [ 0.9056974411010742, 0.893288261559094 ], [ 0.9056974411010742, 0.9190641398001107 ], [ 0.03021061420440674, 0.9190641398001107 ] ]
