  "regions" : [ {
    "source" : "Plooom!!",
    "translation" : "Plooom!!",
    "kind" : "text_free",
    "polygon" : [ [ 0.22416666666666665, 0.018674698795180723 ], [ 0.36833333333333335, 0.0 ], [ 0.37416666666666665, 0.021686746987951807 ], [ 0.22916666666666666, 0.03975903614457831 ] ]
  }, {
    "source" : "¡Eso es! Redimensionado.\n¡Ahora está perfecto!\n",
    "translation" : "É isso aí! Redimensionado. Agora está perfeito!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.3902971649169922, 0.02264681436929358 ], [ 0.5980062357584636, 0.02264681436929358 ], [ 0.5980062357584636, 0.05795243504535721 ], [ 0.3902971649169922, 0.05795243504535721 ] ]
  }, {
    "source" : "No veo qué mal\npodría hacer si llevo\neste árbol fuera de la\nmicrodimensión.\n",
    "translation" : "Não vejo que mal faria se eu levasse esta árvore para fora da microdimensão.",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.40406168619791666, 0.06500797041927475 ], [ 0.5897185770670573, 0.06500797041927475 ], [ 0.5897185770670573, 0.13211352796439665 ], [ 0.40406168619791666, 0.13211352796439665 ] ]
  }, {
    "source" : "Solo es un árbol de\nUnidad; no es como un\n«Hechizo de Destrucción».\n",
    "translation" : "É apenas uma árvore de Unidade; não é como um \"Feitiço de Destruição\".",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.7066666666666667, 0.0608433734939759 ], [ 0.9275, 0.06144578313253012 ], [ 0.9275, 0.10542168674698796 ], [ 0.7066666666666667, 0.10481927710843374 ] ]
  }, {
    "source" : "Bueno,\n",
    "translation" : "Bom,",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.0775, 0.6469879518072289 ], [ 0.13166666666666665, 0.6475903614457831 ], [ 0.13166666666666665, 0.658433734939759 ], [ 0.0775, 0.6578313253012048 ] ]
  }, {
    "source" : "es hora de desplegar esta microdimensión sobre la realidad y mostrarles cómo de creativo puede ser el Caos.",
    "translation" : "é hora de desdobrar esta microdimensão sobre a realidade e mostrar a elas o quão criativo o Caos pode ser.",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.0408820374806722, 0.6712111139871988 ], [ 0.1995775858561198, 0.6712111139871988 ], [ 0.1995775858561198, 0.7898952989693148 ], [ 0.0408820374806722, 0.7898952989693148 ] ]
  }, {
    "source" : "¡Estoy impaciente\npor ver qué\ncara ponen mis\nmadrinas!",
    "translation" : "Mal posso esperar para ver a cara que as minhas madrinhas vão fazer!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.042852624257405596, 0.8017401637801205 ], [ 0.19243927001953126, 0.8017401637801205 ], [ 0.19243927001953126, 0.8677730698183358 ], [ 0.042852624257405596, 0.8677730698183358 ] ]
  }, {
    "source" : "DOooong!!\n",
    "translation" : " DOooong!!",
    "kind" : "text_free",
    "polygon" : [ [ 0.5641666666666667, 0.6150602409638555 ], [ 0.7316666666666667, 0.6072289156626506 ], [ 0.7341666666666666, 0.6349397590361445 ], [ 0.5666666666666667, 0.6427710843373494 ] ]
  }, {
    "source" : "Mmm... Pimienta ha vuelto.",
    "translation" : "Mmm... Pimenta voltou.",
