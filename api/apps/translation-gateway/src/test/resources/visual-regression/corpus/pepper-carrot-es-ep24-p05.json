  "regions" : [ {
    "source" : "Plooom!!",
    "translation" : "Plooom!!",
    "kind" : "text_free",
    "polygon" : [ [ 0.22416666666666665, 0.018674698795180723 ], [ 0.36833333333333335, 0.0 ], [ 0.37416666666666665, 0.021686746987951807 ], [ 0.22916666666666666, 0.03975903614457831 ] ]
  }, {
    "source" : "¡Eso es! Redimensionado.\n¡Ahora está perfecto!\n",
    "translation" : " É isso aí! Redimensionado. Agora está perfeito!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.3933333333333333, 0.02530120481927711 ], [ 0.5958333333333333, 0.02530120481927711 ], [ 0.5958333333333333, 0.05542168674698795 ], [ 0.3933333333333333, 0.05542168674698795 ] ]
  }, {
    "source" : "No veo qué mal\npodría hacer si llevo\neste árbol fuera de la\nmicrodimensión.\n",
    "translation" : " Não vejo que mal eu poderia causar se levasse esta árvore para fora da microdimensão.",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.41083333333333333, 0.06927710843373494 ], [ 0.5841666666666666, 0.06927710843373494 ], [ 0.5841666666666666, 0.12771084337349398 ], [ 0.41083333333333333, 0.12771084337349398 ] ]
  }, {
    "source" : "Solo es un árbol de\nUnidad; no es como un\n«Hechizo de Destrucción».\n",
    "translation" : " É apenas uma árvore de Unidade; não é como um \"Feitiço de Destruição\".",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.7066666666666667, 0.0608433734939759 ], [ 0.9275, 0.06144578313253012 ], [ 0.9275, 0.10542168674698796 ], [ 0.7066666666666667, 0.10481927710843374 ] ]
  }, {
    "source" : "Bueno,\n",
    "translation" : " Bom,",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.0775, 0.6469879518072289 ], [ 0.13166666666666665, 0.6475903614457831 ], [ 0.13166666666666665, 0.658433734939759 ], [ 0.0775, 0.6578313253012048 ] ]
  }, {
    "source" : "es hora de desplegar esta microdimensión sobre la realidad y mostrarles cómo de creativo puede ser el Caos.",
    "translation" : " É hora de desdobrar esta microdimensão sobre a realidade e mostrar a vocês o quão criativo o Caos pode ser.",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.041666666666666664, 0.6746987951807228 ], [ 0.19583333333333333, 0.6746987951807228 ], [ 0.19583333333333333, 0.786144578313253 ], [ 0.041666666666666664, 0.786144578313253 ] ]
  }, {
    "source" : "Estoy impaciente por ver qué cara ponen mis madrinas!",
    "translation" : " Estou ansiosa para ver a cara que as minhas madrinhas vão fazer!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.050833333333333335, 0.8042168674698795 ], [ 0.19, 0.8042168674698795 ], [ 0.19, 0.863855421686747 ], [ 0.050833333333333335, 0.863855421686747 ] ]
  }, {
