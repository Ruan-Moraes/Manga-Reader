    "polygon" : [ [ 0.5851710510253906, 0.6658043551157756 ], [ 0.7317379252115885, 0.6658043551157756 ], [ 0.7317379252115885, 0.699240590290851 ], [ 0.5851710510253906, 0.699240590290851 ] ]
  }, {
