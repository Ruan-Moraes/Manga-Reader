    "kind" : "text_free",
    "polygon" : [ [ 0.5641666666666667, 0.6150602409638555 ], [ 0.7316666666666667, 0.6072289156626506 ], [ 0.7341666666666666, 0.6349397590361445 ], [ 0.5666666666666667, 0.6427710843373494 ] ]
  }, {
    "source" : "Mmm... Pimienta ha vuelto.",
    "translation" : " Mmm... Pimienta está de volta.",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.5883333333333334, 0.6692771084337349 ], [ 0.7291666666666666, 0.6692771084337349 ], [ 0.7291666666666666, 0.6951807228915663 ], [ 0.5883333333333334, 0.6951807228915663 ] ]
  }, {
