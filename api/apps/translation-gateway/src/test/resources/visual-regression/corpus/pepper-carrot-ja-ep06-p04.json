    "polygon" : [ [ 0.33416666666666667, 0.014457831325301205 ], [ 0.49083333333333334, 0.014457831325301205 ], [ 0.49083333333333334, 0.0608433734939759 ], [ 0.33416666666666667, 0.0608433734939759 ] ]
  }, {
    "source" : "3人目の参加者は\n沈む月の土地から\nやってきました!\n",
    "translation" : " O terceiro participante veio da terra da lua poente!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.5225, 0.015060240963855422 ], [ 0.6891666666666667, 0.015060240963855422 ], [ 0.6891666666666667, 0.06144578313253012 ], [ 0.5225, 0.06144578313253012 ] ]
  }, {
    "source" : "サフラン!\n",
    "translation" : " Açafrão!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.36083333333333334, 0.08855421686746988 ], [ 0.46166666666666667, 0.0891566265060241 ], [ 0.46166666666666667, 0.10421686746987951 ], [ 0.36083333333333334, 0.10361445783132531 ] ]
  }, {
    "source" : "シチミ!\n",
    "translation" : " Shichimi!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.5641666666666667, 0.0891566265060241 ], [ 0.6425, 0.0891566265060241 ], [ 0.6425, 0.10361445783132531 ], [ 0.5641666666666667, 0.10361445783132531 ] ]
  }, {
    "source" : "コンテスト開始です!",
    "translation" : " O concurso vai começar!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.11, 0.4566265060240964 ], [ 0.2025, 0.4566265060240964 ], [ 0.2025, 0.4867469879518072 ], [ 0.11, 0.4867469879518072 ] ]
  }, {
    "source" : "拍手メーターで投票が行われます",
    "translation" : " A votação será realizada por meio do medidor de aplausos.",
