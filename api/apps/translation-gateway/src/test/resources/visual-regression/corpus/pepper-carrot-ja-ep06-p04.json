    "polygon" : [ [ 0.3958333333333333, 0.594578313253012 ], [ 0.5741666666666667, 0.5951807228915663 ], [ 0.5741666666666667, 0.6259036144578313 ], [ 0.3958333333333333, 0.6253012048192771 ] ]
