  "regions" : [ {
    "source" : "偉大なる技術者連合からやってきました魅惑の天才を迎えることができて光栄ですコリアンダー!",
    "translation" : "É uma honra receber o gênio fascinante vindo da grandiosa União dos Engenheiros: Coriander!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.04425031026204427, 0.010647132597773909 ], [ 0.28951929728190107, 0.010647132597773909 ], [ 0.28951929728190107, 0.1096158498741058 ], [ 0.04425031026204427, 0.1096158498741058 ] ]
  }, {
    "source" : "我が街コモナの\n魔女を忘れるなど\nありえません\n",
    "translation" : "É impossível esquecer a bruxa da nossa cidade, Komona...",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.32324732462565103, 0.009507789956517966 ], [ 0.49631439208984374, 0.009507789956517966 ], [ 0.49631439208984374, 0.06777124060205666 ], [ 0.32324732462565103, 0.06777124060205666 ] ]
  }, {
    "source" : "3人目の参加者は\n沈む月の土地から\nやってきました!\n",
    "translation" : "A terceira participante veio da terra da lua poente!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.5063101704915365, 0.0103942905563906 ], [ 0.698234608968099, 0.0103942905563906 ], [ 0.698234608968099, 0.06897817404873399 ], [ 0.5063101704915365, 0.06897817404873399 ] ]
  }, {
    "source" : "サフラン!\n",
    "translation" : "Saffron!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.36083333333333334, 0.08855421686746988 ], [ 0.46166666666666667, 0.0891566265060241 ], [ 0.46166666666666667, 0.10421686746987951 ], [ 0.36083333333333334, 0.10361445783132531 ] ]
  }, {
    "source" : "シチミ!\n",
    "translation" : "Shichimi!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.5641666666666667, 0.0891566265060241 ], [ 0.6433333333333333, 0.08975903614457831 ], [ 0.6433333333333333, 0.10421686746987951 ], [ 0.5641666666666667, 0.10361445783132531 ] ]
  }, {
    "source" : "コンテスト開始です!",
    "translation" : "O concurso vai começar!",
