    "polygon" : [ [ 0.2675, 0.5036144578313253 ], [ 0.4216666666666667, 0.5036144578313253 ], [ 0.4216666666666667, 0.5343373493975904 ], [ 0.2675, 0.5343373493975904 ] ]
  }, {
    "source" : "そして、最後の参加者はリスのはずれの森からきましたペッパー!",
    "translation" : " E o último participante é o Pepper, que veio da Floresta da Periferia dos Esquilos!",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.7616666666666667, 0.015060240963855422 ], [ 0.9108333333333334, 0.015060240963855422 ], [ 0.9108333333333334, 0.10421686746987951 ], [ 0.7616666666666667, 0.10421686746987951 ] ]
  }, {
    "source" : "まず最初はコリアンダーによる実演です",
    "translation" : " Para começar, teremos uma demonstração com coentro.",
    "kind" : "text_bubble",
    "polygon" : [ [ 0.16333333333333333, 0.6006024096385543 ], [ 0.335, 0.6006024096385543 ], [ 0.335, 0.6481927710843374 ], [ 0.16333333333333333, 0.6481927710843374 ] ]
  }, {
