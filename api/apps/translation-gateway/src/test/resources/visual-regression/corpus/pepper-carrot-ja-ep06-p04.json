    "polygon" : [ [ 0.09955993016560873, 0.4525093905897026 ], [ 0.21352068583170572, 0.4525093905897026 ], [ 0.21352068583170572, 0.4910957060664533 ], [ 0.09955993016560873, 0.4910957060664533 ] ]
  }, {
    "source" : "拍手メーターで投票が行われます",
