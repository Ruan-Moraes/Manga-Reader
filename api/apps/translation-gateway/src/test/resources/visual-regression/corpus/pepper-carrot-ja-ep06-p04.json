    "kind" : "text_bubble",
    "polygon" : [ [ 0.2621009826660156, 0.4996313623635166 ], [ 0.42621927897135414, 0.4996313623635166 ], [ 0.42621927897135414, 0.5382403637989458 ], [ 0.2621009826660156, 0.5382403637989458 ] ]
  }, {
