{
    "expo": {
        "name": "Toonlira",
        "slug": "toonlira",
        "version": "1.0.0",
        "orientation": "default",
        "icon": "./assets/images/icon.png",
        "scheme": "toonlira",
        "userInterfaceStyle": "automatic",
        "ios": {
            "bundleIdentifier": "com.toonlira.app",
            "supportsTablet": true,
            "icon": {
                "light": "./assets/images/icon.png",
                "dark": "./assets/images/icon-dark.png",
                "tinted": "./assets/images/icon-tinted.png"
            }
        },
        "android": {
            "package": "com.toonlira.app",
            "allowBackup": false,
            "blockedPermissions": [
                "android.permission.CAMERA",
                "android.permission.RECORD_AUDIO",
                "android.permission.READ_MEDIA_IMAGES",
                "android.permission.READ_EXTERNAL_STORAGE",
                "android.permission.WRITE_EXTERNAL_STORAGE"
            ],
            "adaptiveIcon": {
                "backgroundColor": "#000000",
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 240,
                    "resizeMode": "contain",
                    "backgroundColor": "#F6F4EE",
                    "dark": {
                        "image": "./assets/images/splash-icon.png",
                        "backgroundColor": "#11110F"
                    }
                }
            ],
            "expo-font",
            "expo-secure-store",
            "expo-web-browser",
            [
                "expo-image-picker",
                {
                    "cameraPermission": false,
                    "microphonePermission": false,
                    "photosPermission": "Select only the images you want to import into Toonlira."
                }
            ],
            "expo-sqlite"
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "externalLinks": {
                "terms": "https://toonlira-rm.web.app/legal/terms",
                "privacy": "https://toonlira-rm.web.app/legal/privacy"
            }
        }
    }
}
