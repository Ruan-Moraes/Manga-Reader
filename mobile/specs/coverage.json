{
    "version": 1,
    "ignored": [".DS_Store", "**/*.tsbuildinfo", "node_modules/**", ".expo/**", "coverage/**"],
    "patterns": [
        {
            "pattern": ".agents/**",
            "category": "governance",
            "specs": ["MOB-DEC-001"],
            "rationale": "Papéis executáveis do workflow SDD; não representam comportamento do produto."
        },
        {
            "pattern": "assets/**",
            "category": "resource",
            "specs": ["MOB-BASE-001", "MOB-BASE-004"],
            "rationale": "Fontes e imagens consumidas por configuração Expo ou apresentação auth; arquivos isolados não criam comportamento."
        },
        {
            "pattern": "docs/**",
            "category": "governance",
            "specs": ["MOB-DEC-001"],
            "rationale": "Referências visuais estáticas e não normativas."
        },
        {
            "pattern": "scripts/**",
            "category": "infrastructure",
            "specs": ["MOB-DEC-001", "MOB-DEC-002"],
            "rationale": "Automação de gates e validação, sem comportamento de produto."
        },
        {
            "pattern": "specs/**",
            "category": "governance",
            "specs": ["MOB-DEC-001"],
            "rationale": "Artefatos normativos, templates e relatórios do workflow SDD."
        }
    ],
    "entries": [
        { "path": ".gitignore", "category": "infrastructure", "specs": ["MOB-DEC-001"], "rationale": "Política de arquivos locais e gerados." },
        { "path": ".prettierignore", "category": "infrastructure", "specs": ["MOB-DEC-001"], "rationale": "Escopo do gate de formatação." },
        { "path": ".prettierrc", "category": "infrastructure", "specs": ["MOB-DEC-001"], "rationale": "Configuração do formatador." },
        { "path": "AGENTS.md", "category": "governance", "specs": ["MOB-DEC-001"], "rationale": "Guardrails locais do SDD." },
        { "path": "README.md", "category": "governance", "specs": ["MOB-DEC-001"], "rationale": "Referência técnica do módulo." },
        { "path": "app.json", "category": "behavior", "specs": ["MOB-BASE-001"], "observations": ["MOB-BASE-001/OBS-006", "MOB-BASE-001/OBS-007"] },
        {
            "path": "babel.config.js",
            "category": "infrastructure",
            "specs": ["MOB-BASE-001"],
            "observations": ["MOB-BASE-001/OBS-008"],
