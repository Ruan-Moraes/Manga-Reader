{
    "name": "mobile",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "scripts": {
        "dev": "expo start --clear",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "test": "jest --watch",
        "test:ci": "jest --ci --runInBand",
        "specs:check": "node --test scripts/spec-coverage.test.mjs scripts/feature-gates.test.mjs scripts/sdd-integrity.test.mjs && node scripts/validate-specs.mjs && node scripts/check-doc-links.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:fsd": "node --test scripts/fsd-boundaries.test.mjs && CHOKIDAR_USEPOLLING=1 steiger ./src && node scripts/validate-fsd.mjs",
        "check": "pnpm specs:check && pnpm typecheck && pnpm lint && pnpm lint:fsd && pnpm format:check && pnpm test:ci"
    },
    "dependencies": {
        "@expo-google-fonts/nunito-sans": "^0.4.2",
        "@expo/dom-webview": "~57.0.1",
        "@expo/metro-runtime": "~57.0.15",
        "@expo/vector-icons": "^15.0.3",
        "@hookform/resolvers": "^5.4.0",
        "@tanstack/react-query": "^5.101.0",
        "axios": "^1.17.0",
        "babel-preset-expo": "~57.0.10",
        "expo": "~57.0.20",
        "expo-constants": "~57.0.17",
        "expo-crypto": "~57.0.2",
        "expo-file-system": "~57.0.6",
        "expo-font": "~57.0.3",
        "expo-image": "~57.0.4",
        "expo-image-picker": "~57.0.16",
        "expo-linking": "~57.0.9",
        "expo-router": "~57.0.19",
        "expo-secure-store": "~57.0.3",
        "expo-sharing": "~57.0.18",
        "expo-splash-screen": "~57.0.8",
        "expo-sqlite": "~57.0.2",
        "expo-status-bar": "~57.0.1",
        "expo-web-browser": "~57.0.2",
        "i18next": "^26.3.1",
        "nativewind": "^4.2.6",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-hook-form": "^7.77.0",
        "react-i18next": "^17.0.8",
        "react-native": "0.86.3",
        "react-native-css-interop": "0.2.6",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-svg": "15.15.4",
        "react-native-web": "~0.21.0",
        "react-native-worklets": "0.10.1",
        "tailwindcss": "^3.4.19",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@feature-sliced/steiger-plugin": "^0.6.0",
        "@testing-library/react-native": "^13.3.3",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.0.0",
        "@types/react": "~19.2.0",
        "@types/react-test-renderer": "19.1.0",
        "axios-mock-adapter": "^2.1.0",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "jest": "^29.7.0",
        "jest-expo": "~57.0.5",
        "prettier": "^3.8.4",
        "react-test-renderer": "19.2.3",
        "steiger": "^0.5.13",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.61.1"
    },
    "private": true
